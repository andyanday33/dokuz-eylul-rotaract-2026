# Copy to `.env` and fill in. Both `npm run dev` and `scripts/deploy.sh` read
# this file; `.env` itself is gitignored and never enters the Docker image.
#
# Everything here comes from the Supabase project dashboard except
# PAYLOAD_SECRET, which you generate.

# --- Supabase — Project Settings → API ------------------------------------
# Both of these are inlined into the client bundle at build time, so treat them
# as public. The publishable key is meant to be.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row level security; used solely to issue invitations.
# Never prefix this with NEXT_PUBLIC_ — that would publish it in the JavaScript
# sent to every visitor.
SUPABASE_SECRET_KEY=

# --- The site's own origin ------------------------------------------------
# Two jobs, and the second is why this is not really optional in production.
#
#   * Auth links. Needed when the app sits behind a proxy that rewrites the
#     host, so a sign-in link cannot be built from the incoming request.
#   * Canonical URLs, hreflang and Open Graph tags. The public pages are
#     prerendered, so these are written at BUILD time — see lib/seo.ts. Unset,
#     every page ships claiming to live at http://localhost:3000. The site
#     looks perfect and search engines index nothing.
#
# Because it is read at build time, changing it means deploying again;
# restarting the container will not pick it up.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Payload CMS ----------------------------------------------------------
# Same database as above, separate `payload` schema.
#
# Copy this from Supabase → Connect → "Session pooler" (port 5432), and paste
# the database password into it. Two things about that choice:
#   * The pooler, not "Direct connection": this project has no direct host.
#   * Session mode on 5432, not transaction mode on 6543 — Drizzle uses
#     prepared statements, which the transaction pooler does not support.
#
# The build reads this as well as the running site: `next build` prerenders the
# public pages by querying Payload.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Signs the admin panel's session cookies. Any long random string:
#   openssl rand -base64 32
# Changing it signs every editor out, and it is not recoverable from anywhere
# else — keep it with the rest of the deployment's secrets.
PAYLOAD_SECRET=

# --- Runtime (optional) ---------------------------------------------------
# The host port Compose publishes on, bound to 127.0.0.1 for the reverse proxy.
# Change it if something else on the box already holds 3000.
# PORT=3000
# IMAGE_NAME=rotaract-frontend
