# Copy to `.env` and fill in. Both `npm run dev` and `scripts/deploy.sh` read
# this file; `.env` itself is gitignored and never enters the Docker image.
#
# Every value comes from the Supabase project dashboard except PAYLOAD_SECRET,
# which you generate.

# --- Supabase: the members area's sign-in ---------------------------------
# Settings → API. Both of these are inlined into the client bundle at build
# time, so treat them as public — the publishable key is meant to be.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only, and it bypasses row-level security. Never prefix it with
# NEXT_PUBLIC_ — that would publish it in the JavaScript sent to every visitor.
SUPABASE_SECRET_KEY=

# --- Postgres: everything the CMS stores ----------------------------------
# Settings → Database → Connection string → Session pooler (port 5432). The
# build reads this as well as the running site: `next build` prerenders the
# public pages by querying Payload.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# --- Payload --------------------------------------------------------------
# Signs the admin panel's session cookies. Any long random string:
#   openssl rand -base64 32
# Changing it signs every editor out; it is not recoverable from anywhere else,
# so keep it with the rest of the deployment's secrets.
PAYLOAD_SECRET=

# --- Runtime (optional) ---------------------------------------------------
# The host port Compose publishes on, bound to 127.0.0.1 for the reverse proxy.
# PORT=3000
# IMAGE_NAME=rotaract-frontend
