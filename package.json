{
  "name": "frontend2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bootstrap:board": "node --env-file=.env scripts/bootstrap-board.mjs",
    "signin:link": "node --env-file=.env scripts/signin-link.mjs",
    "payload": "node --env-file=.env ./node_modules/payload/bin.js",
    "cms:types": "npm run payload -- generate:types",
    "cms:importmap": "npm run payload -- generate:importmap",
    "cms:migrate": "npm run payload -- migrate",
    "cms:migrate:create": "npm run payload -- migrate:create",
    "cms:seed": "npm run payload -- run scripts/seed-cms.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "next": "16.3.0",
    "payload": "^3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
